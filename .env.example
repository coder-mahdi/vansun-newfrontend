# Copy to `.env.local` and fill in. Never commit `.env.local`.
# reCAPTCHA secret (server-only; not exposed to the browser)
RECAPTCHA_SECRET_KEY=

# Home page: GET …/vansun/v1/content/home-about when NEXT_PUBLIC_CONSENT_API_URL
# (or CONTENT_API_URL / API_URL) is set; no CONTENT_MODE required (same as blogs).
# ACF page fallback only if NEXT_PUBLIC_CONTENT_MODE=live and NEXT_PUBLIC_CMS_API_URL.
#
# Optional overrides:
# NEXT_PUBLIC_HOME_CONTENT_API_PATH=/content/home-about
# ACF fallback page slug if API missing:
# NEXT_PUBLIC_HOME_CMS_PAGE_SLUG=hero-data
#
# Booking /piercing and /tattoo FAQs: use src/data/faqs.ts when NEXT_PUBLIC_CONTENT_MODE
# is not live, or set NEXT_PUBLIC_BOOKING_FAQ_MOCK=1 to force those mocks even in live mode.
#
# About page, Google reviews block (optional live pull, server-only key):
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
# Optional: NEXT_PUBLIC_GOOGLE_REVIEWS_URL= (Maps / search link; default is a stable Google search)
